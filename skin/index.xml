<?xml version="1.0" encoding="UTF-8"?>
<skin>
  <information>
    <name><![CDATA[Gutter]]></name>
    <version><![CDATA[0.1.0]]></version>
    <description><![CDATA[개발 블로그용 티스토리 스킨 — 문법 강조 팔레트, 코드블록 라인 넘버 거터, 다크모드]]></description>
    <license><![CDATA[MIT License]]></license>
  </information>

  <author>
    <name><![CDATA[ZIAHO]]></name>
    <homepage><![CDATA[https://github.com/zziaho/tistory-gutter-skin]]></homepage>
    <email><![CDATA[]]></email>
  </author>

  <!-- 스킨이 권장하는 설정 기본값. 관리 화면의 스킨 설정과 달리 여기 값은
       사용자에게 노출되지 않고 스킨이 정합니다.
       showValue 가 핵심입니다. 이걸 켜야 카테고리에 글 수가 붙고,
       script.js 의 initCategoryCount 가 그 숫자를 읽어 글 하단에 (N files) 를
       표시합니다. 꺼져 있으면 그 기능이 조용히 동작하지 않습니다. -->
  <default>
    <entriesOnPage>10</entriesOnPage>
    <entriesOnList>10</entriesOnList>
    <itemsOnGuestbook>10</itemsOnGuestbook>
    <tagsInCloud>40</tagsInCloud>
    <sortInCloud>1</sortInCloud>
    <expandComment>1</expandComment>
    <expandTrackback>0</expandTrackback>
    <showListOnCategory>1</showListOnCategory>
    <tree>
      <color>000000</color>
      <bgColor>ffffff</bgColor>
      <activeColor>000000</activeColor>
      <activeBgColor>eeeeee</activeBgColor>
      <labelLength>27</labelLength>
      <showValue>1</showValue>
    </tree>
    <!-- 본문 문단 폭에 맞춥니다. style.css 의 measure 토큰 82ch 가 약 745px 입니다.
         에디터 위지윅 폭이 실제 화면과 어긋나지 않게 하는 값입니다. -->
    <contentWidth>745</contentWidth>
  </default>

  <variables>
    <variable>
      <name>accent</name>
      <label>강조 색상 (카테고리)</label>
      <type>COLOR</type>
      <default>#a626a4</default>
      <description>카테고리와 경로에 쓰는 강조 색상. 바꿀 때는 흰 배경에서 대비 4.5:1 을 넘는지 확인하세요. 코드블록 안의 색은 이 옵션을 따르지 않으므로 영향받지 않습니다.</description>
    </variable>

    <variable>
      <name>link_color</name>
      <label>링크 색상</label>
      <type>COLOR</type>
      <default>#2364f0</default>
      <description>본문 링크와 활성 항목 색상. 바꿀 때는 흰 배경에서 대비 4.5:1 을 넘는지 확인하세요.</description>
    </variable>

    <variable>
      <name>line_numbers</name>
      <label>코드블록 라인 넘버</label>
      <type>BOOL</type>
      <default>true</default>
      <description>코드블록 왼쪽에 줄 번호 거터를 표시합니다</description>
    </variable>

    <variable>
      <name>dark_mode_default</name>
      <label>기본 다크모드 여부</label>
      <type>BOOL</type>
      <default>false</default>
      <description>기본 다크모드 여부</description>
    </variable>

    <variable>
      <name>show_toc</name>
      <label>목차 표시</label>
      <type>BOOL</type>
      <default>true</default>
      <description>글 상세 좌측에 목차를 표시합니다</description>
    </variable>

    <variable>
      <name>show_categories</name>
      <label>카테고리 표시</label>
      <type>BOOL</type>
      <default>true</default>
      <description>우측에 카테고리 목록을 표시합니다</description>
    </variable>

    <variable>
      <name>subtitle</name>
      <label>블로그 부제</label>
      <type>STRING</type>
      <default>개발과 일상을 기록합니다</default>
      <description>블로그 부제</description>
    </variable>

    <variable>
      <name>author_name</name>
      <label>작성자 이름</label>
      <type>STRING</type>
      <default></default>
      <description>구조화 데이터에 쓰는 작성자 이름. 비워두면 작성자 정보를 넣지 않습니다.</description>
    </variable>

    <variable>
      <name>author_url</name>
      <label>작성자 프로필 주소</label>
      <type>STRING</type>
      <default></default>
      <description>GitHub 등 작성자 프로필 주소</description>
    </variable>

    <variable>
      <name>adsense_client</name>
      <label>애드센스 게시자 ID</label>
      <type>STRING</type>
      <default></default>
      <description>본인 계정의 ca-pub-으로 시작하는 ID. 비워두면 광고 스크립트를 넣지 않습니다.</description>
    </variable>

    <variable>
      <name>adsense_slot</name>
      <label>애드센스 본문 상단 광고 슬롯 ID</label>
      <type>STRING</type>
      <default></default>
      <description>글 본문 위에 넣을 광고 유닛의 슬롯 번호. 비워두면 넣지 않습니다.</description>
    </variable>

    <variable>
      <name>adsense_slot_bottom</name>
      <label>애드센스 본문 하단 광고 슬롯 ID</label>
      <type>STRING</type>
      <default></default>
      <description>글을 다 읽은 자리에 넣을 광고 유닛의 슬롯 번호. 비워두면 넣지 않습니다. 상단과 다른 유닛을 쓰는 편이 성과 확인에 낫습니다.</description>
    </variable>
  </variables>
</skin>
